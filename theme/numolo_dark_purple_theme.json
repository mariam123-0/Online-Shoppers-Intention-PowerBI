{
  "name": "Numolo Dark Purple",
  "dataColors": ["#A855F7", "#E879F9", "#8B5CF6", "#C4B5FD", "#6D28D9", "#F0ABFC", "#7C3AED", "#DDD6FE"],
  "background": "#1A1233",
  "foreground": "#FFFFFF",
  "tableAccent": "#A855F7",
  "good": "#34D399",
  "bad": "#F87171",
  "neutral": "#C4B5FD",
  "maximum": "#E879F9",
  "center": "#A855F7",
  "minimum": "#4C1D95",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#FFFFFF" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#C4B5FD" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#FFFFFF" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0B0716" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#1A1233" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#2E2352" } }, "radius": 16 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#FFFFFF" } }, "fontSize": 13, "fontFamily": "Segoe UI Semibold" }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#C4B5FD" } }, "gridlineShow": false }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#C4B5FD" } }, "gridlineColor": { "solid": { "color": "#2E2352" } } }],
        "legend": [{ "labelColor": { "solid": { "color": "#C4B5FD" } } }],
        "labels": [{ "color": { "solid": { "color": "#FFFFFF" } } }]
      }
    }
  }
}
